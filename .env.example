# Copy to .env.local and fill in what you have. Everything is optional in
# development; the app runs on the sample restaurant without any of it.

# Claude: powers the copilot, payout-mail fallback parsing, and document/menu reading.
# Without it the copilot runs in basic (keyword) mode and document reading is off.
ANTHROPIC_API_KEY=
# ZEST_MODEL=claude-opus-5-5

# Encrypts stored platform credentials (AES-256-GCM) and signs the session cookie.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZEST_SECRET_KEY=

# Database. Defaults to a local SQLite file at .data/zest.db.
# For production use a hosted libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Partner APIs, once you have partner access (paths in lib/server/connectors.ts).
# ZOMATO_PARTNER_API_URL=
# SWIGGY_PARTNER_API_URL=

# Signed order webhooks (POST /api/webhooks/{zomato|swiggy|dine}, header X-Zest-Signature = hex HMAC-SHA256 of the body).
# WEBHOOK_SECRET=

# Gmail connector (Google Cloud OAuth client, "Web application"). Redirect URI:
#   <your site>/api/mail/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://zest-dusky.vercel.app   # optional; on Vercel the production domain is used automatically
# GMAIL_SENDERS=zomato.com,swiggy.in,swiggy.com

# Zomato listing reader. Zomato blocks data-centre IPs (including Vercel), so in
# production route its page requests through a scraping relay. {url} is replaced
# with the page address, e.g. ScraperAPI:
# ZOMATO_FETCH_VIA=https://api.scraperapi.com/?api_key=YOUR_KEY&country_code=in&url={url}

# Scheduled sync (GET /api/cron with "Authorization: Bearer $CRON_SECRET"). Vercel Cron sends it automatically.
# CRON_SECRET=

# Protects POST /api/ingest/email (header X-Ingest-Secret) when set.
# INGEST_SECRET=

# WhatsApp Business Cloud API. Without these, messages wait in the outbox as "queued".
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=        # approved template with one text parameter, for messages outside the 24-hour window

# Largest spend cap any single promo can have, in rupees.
# MAX_PROMO_SPEND=10000

# In production the sample restaurant is read-only. Set to 1 to let visitors change it.
# ZEST_DEMO_WRITABLE=1

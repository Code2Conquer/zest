# Copy to .env.local and fill in what you have. Everything is optional in
# development; the app runs on the sample restaurant without any of it.

# AI: powers the assistants, payout-mail fallback parsing, and document/menu reading. Pick one:
#   Claude (best at handwritten/Hindi menus and PDFs):
# ANTHROPIC_API_KEY=
# ZEST_MODEL=claude-opus-5-5
#   Or a free open model through any OpenAI-compatible API (Groq's free tier by default; photos only, no PDFs):
# LLM_API_KEY=                     # from console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Without either, the assistants run in basic (keyword) mode and photo reading is off.

# Encrypts stored platform credentials (AES-256-GCM) and signs the session cookie.
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZEST_SECRET_KEY=

# Database. Defaults to a local SQLite file at .data/zest.db.
# For production use a hosted libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Partner APIs, once you have partner access (paths in lib/server/connectors.ts).
# ZOMATO_PARTNER_API_URL=
# SWIGGY_PARTNER_API_URL=

# Signed order webhooks (POST /api/webhooks/{zomato|swiggy|dine}, header X-Zest-Signature = hex HMAC-SHA256 of the body).
# WEBHOOK_SECRET=

# Gmail connector (Google Cloud OAuth client, "Web application"). Redirect URI:
#   <your site>/api/mail/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://zest-dusky.vercel.app   # optional; on Vercel the production domain is used automatically
# GMAIL_SENDERS=zomato.com,swiggy.in,swiggy.com

# Sign-in. Owners and managers log in with their mobile number (a 4-digit code) or "Continue with Google"
# (same OAuth client as Gmail; add <your site>/api/auth/google/callback as a second redirect URI).
# Until WhatsApp or SMS codes are set up, production uses the number's last 4 digits as the code;
# set ZEST_LAST4_OTP=off to refuse that. Kitchen, cashier and rider staff sign in with a PIN.
# WHATSAPP_OTP_TEMPLATE=   # an approved authentication template
# MSG91_AUTH_KEY=          # SMS fallback (DLT-registered templates)
# MSG91_OTP_TEMPLATE=
# MSG91_ORDER_TEMPLATE=    # variables: shop, update, link

# Online payments (Razorpay). Webhook: <your site>/api/payments/webhook for payment.captured.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Zomato rider booking, once Zest has delivery API access.
# ZOMATO_DELIVERY_API_URL=
# ZOMATO_DELIVERY_API_KEY=

# Analytics. PostHog (free cloud plan) for funnels; Vercel Web Analytics and Speed Insights are switched on
# in the Vercel dashboard and need no key.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Support contact shown in the footer and legal pages.
# NEXT_PUBLIC_SUPPORT_WHATSAPP=
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Zomato/Swiggy listing reader. Zomato blocks data-centre IPs (including Vercel), so in
# production route listing requests through a scraping relay. {url} is replaced
# with the page address, e.g. ScraperAPI:
# LISTING_FETCH_VIA=https://api.scraperapi.com/?api_key=YOUR_KEY&country_code=in&url={url}

# Scheduled sync (GET /api/cron with "Authorization: Bearer $CRON_SECRET"). Vercel Cron sends it automatically.
# CRON_SECRET=

# Protects POST /api/ingest/email (header X-Ingest-Secret) when set.
# INGEST_SECRET=

# WhatsApp Business Cloud API. Without these, messages wait in the outbox as "queued".
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=        # approved template with one text parameter, for messages outside the 24-hour window

# Largest spend cap any single promo can have, in rupees.
# MAX_PROMO_SPEND=10000

# In production the sample restaurant is read-only. Set to 1 to let visitors change it.
# ZEST_DEMO_WRITABLE=1

# Error reports (optional, free Sentry Developer plan). Off when unset. Phone numbers and request
# bodies are removed before anything is sent.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
